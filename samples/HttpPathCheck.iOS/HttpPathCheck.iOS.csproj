<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the HTTP-path snippet (snippets/http-path) on the iOS simulator, compiled
       as C# 7.3 like a classic Xamarin.iOS project. Sends only to the local ingest stub. -->
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ApplicationId>com.fload.samples.httppath</ApplicationId>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../snippets/http-path/*.cs" />
  </ItemGroup>
</Project>
