<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiSample.MainPage"
             Title="Fload Attribution">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="Fload Attribution sample" Style="{StaticResource Headline}"
                   SemanticProperties.HeadingLevel="Level1" />

            <Label x:Name="StatusLabel" AutomationId="StatusLabel" />
            <Label x:Name="ReferenceLabel" AutomationId="ReferenceLabel" FontFamily="OpenSansSemibold" />

            <Entry x:Name="UserIdEntry" AutomationId="UserIdEntry" Placeholder="App user id, e.g. RevenueCat's"
                   Text="sample_user_1" />
            <Button x:Name="SetUserButton" AutomationId="SetUserButton" Text="Set user id"
                    Clicked="OnSetUserClicked" HorizontalOptions="Fill" />
            <Label x:Name="UserLabel" AutomationId="UserLabel" />

            <Button Text="Refresh" Clicked="OnRefreshClicked" HorizontalOptions="Fill" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
